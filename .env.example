# ==============================================================================
# Job Application Tracker API - Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Replica Set required for multi-document ACID transactions)
MONGO_URI=mongodb://localhost:27017/job-tracker?replicaSet=rs0

# JWT Access Secret (Notice: ONLY JWT_ACCESS_SECRET is used; refresh tokens are opaque random strings stored as SHA-256 hashes)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-minimum-32-characters-long

# Client CORS Configuration
CLIENT_URL=http://localhost:3000

# Reverse Proxy Trust Configuration (Set to '1' or 'true' when behind reverse proxy like Nginx/Cloudflare/ALB)
TRUST_PROXY=false

# Database Connection Pool Configuration (Initial operational defaults)
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=5
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_SOCKET_TIMEOUT_MS=45000
